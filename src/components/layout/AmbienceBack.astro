---
/**
 * Lo que ilumina la estancia por detrás del contenido: la claridad fría de la
 * ventana, el resplandor de la lumbre (fuera de cuadro, abajo) y sus pavesas.
 * Sobrevive al cambio de página para que el fuego no se interrumpa.
 */
---

<div class="amb" id="amb" transition:persist="amb" aria-hidden="true">
  <div class="amb__cold"></div>
  <div class="amb__hearth">
    <div class="amb__wall"></div>
    <i class="amb__glow amb__glow--wide"></i>
    <i class="amb__glow amb__glow--core"></i>
  </div>
  <canvas class="amb__embers" data-embers></canvas>
</div>

<style>
  .amb {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    contain: strict;
  }

  .amb__cold {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 58% 52% at 6% -6%, rgb(127 149 168 / 0.15), transparent 72%);
  }

  .amb__hearth {
    position: absolute;
    inset: 0;
    transition: opacity 1.8s var(--ease-lamp);
  }

  /* El papel pintado sólo se adivina donde alcanza la luz del fuego */
  .amb__wall {
    position: absolute;
    inset: 0;
    background: var(--wallpaper) 50% 100% / 96px 168px;
    opacity: 0.085;
    -webkit-mask-image: radial-gradient(ellipse 80% 66% at 50% 106%, #000 12%, transparent 74%);
    mask-image: radial-gradient(ellipse 80% 66% at 50% 106%, #000 12%, transparent 74%);
  }

  .amb__glow {
    position: absolute;
    bottom: 0;
    left: 50%;
    border-radius: 50%;
    translate: -50% 47%;
    will-change: opacity, scale;
  }

  .amb__glow--wide {
    width: 150vmax;
    height: 78vmax;
    background: radial-gradient(
      closest-side,
      rgb(217 100 42 / 0.34),
      rgb(143 54 19 / 0.2) 38%,
      rgb(143 54 19 / 0.06) 66%,
      transparent 80%
    );
    animation: an-flicker-wide 5.3s linear infinite;
  }

  .amb__glow--core {
    width: 86vmax;
    height: 44vmax;
    background: radial-gradient(closest-side, rgb(246 178 105 / 0.3), rgb(236 141 68 / 0.12) 45%, transparent 76%);
    animation: an-flicker-core 3.7s linear infinite;
  }

  .amb__embers {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Mientras corre una cinta, la sala baja la luz */
  :global(html.is-projecting) .amb__hearth {
    opacity: 0.42;
  }

  /* Primera visita de la noche: el fuego prende */
  :global(html.is-arriving) .amb__hearth {
    animation: an-catch-fire 3.4s var(--ease-lamp) both;
  }

  @keyframes an-flicker-wide {
    0%, 100% { opacity: 0.84; scale: 1; }
    9% { opacity: 0.76; }
    16% { opacity: 0.93; scale: 1.02; }
    27% { opacity: 0.8; }
    38% { opacity: 0.97; scale: 1.01; }
    46% { opacity: 0.78; scale: 0.985; }
    58% { opacity: 0.9; }
    66% { opacity: 0.72; scale: 0.99; }
    75% { opacity: 0.95; scale: 1.03; }
    88% { opacity: 0.8; }
  }

  @keyframes an-flicker-core {
    0%, 100% { opacity: 0.7; scale: 1; }
    11% { opacity: 1; scale: 1.05; }
    23% { opacity: 0.62; scale: 0.97; }
    37% { opacity: 0.9; }
    49% { opacity: 0.55; scale: 0.95; }
    61% { opacity: 0.95; scale: 1.04; }
    78% { opacity: 0.68; }
    90% { opacity: 0.86; scale: 1.02; }
  }

  @keyframes an-catch-fire {
    0% { opacity: 0; }
    30% { opacity: 0.28; }
    42% { opacity: 0.16; }
    70% { opacity: 0.8; }
    100% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .amb__glow,
    :global(html.is-arriving) .amb__hearth {
      animation: none;
    }
  }
</style>
