---
import Plaque from '@/components/ui/Plaque.astro';
import type { Film } from '@/lib/films';

/**
 * La pantalla de la sala. La cinta arranca sola y gira en bucle, sin cartelas
 * de entrada ni de salida; sólo queda un aviso para cuando falta la bobina o
 * el navegador no sabe leerla. El comportamiento está en src/scripts/projector.ts.
 */
interface Props {
  film: Film;
}
const { film } = Astro.props;
---

<div
  class="projector"
  data-projector
  data-state={film.video ? 'paused' : 'missing'}
  data-silent={film.silent ? '' : undefined}
>
  <div class="projector__screen" data-screen>
    {
      film.video && (
        <video class="projector__film" data-film src={film.video} preload="auto" playsinline loop muted={film.silent} />
      )
    }

    <div class="projector__card">
      <Plaque>
        {
          film.video ? (
            <p class="projector__fault">Este navegador no sabe leer esta bobina.</p>
          ) : (
            <p class="projector__missing">La bobina de esta cinta todavía no ha llegado a la casa.</p>
          )
        }
      </Plaque>
    </div>

    {
      film.video && (
        <>
          <div class="projector__controls">
            <button type="button" data-action="toggle" aria-label="Proyectar">
              <svg class="icon icon--play" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 5.5v13L18.5 12Z" />
              </svg>
              <svg class="icon icon--pause" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 6v12M15 6v12" />
              </svg>
            </button>
            <span data-time>0:00</span>
            <input
              class="projector__seek"
              type="range"
              data-seek
              min="0"
              max="1000"
              step="1"
              value="0"
              aria-label="Avanzar o retroceder en la cinta"
            />
            <span data-duration>0:00</span>
            <button
              class="projector__speed"
              type="button"
              data-action="speed"
              aria-label="Velocidad de proyección"
              title="Velocidad de proyección"
            >
              <span data-speed>1×</span>
            </button>
            <button type="button" data-action="loop" aria-pressed="true" aria-label="Repetir sin fin" title="Repetir sin fin">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12a7 7 0 1 1-2.05-4.95M17 3.4v3.7h-3.7" />
              </svg>
            </button>
            <button type="button" data-action="mute" aria-pressed="false" aria-label="Silenciar la cinta" title="Silenciar la cinta" hidden>
              <svg class="icon icon--sound" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4ZM15.5 9.5a3.5 3.5 0 0 1 0 5M17.8 7a7 7 0 0 1 0 10" />
              </svg>
              <svg class="icon icon--muted" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4ZM15.5 9.5l5 5M20.5 9.5l-5 5" />
              </svg>
            </button>
            <button type="button" data-action="fullscreen" aria-label="Pantalla completa" title="Pantalla completa">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" />
              </svg>
            </button>
          </div>
        </>
      )
    }
  </div>

  {
    film.video && (
      <p class="projector__keys" aria-hidden="true">
        Espacio, pausa · F, pantalla completa · Flechas, avanzar y retroceder
      </p>
    )
  }
</div>

<style>
  .projector {
    --ratio: 4 / 3;
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  .projector__screen {
    position: relative;
    width: min(100%, calc(72svh * (var(--ratio))));
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: clamp(0.9rem, 2vw, 1.6rem);
    background: #030202;
    box-shadow:
      0 0 0 1px rgb(201 170 108 / 0.3),
      0 0 0 0.55rem #0d0907,
      0 0 0 calc(0.55rem + 1px) rgb(155 125 69 / 0.24),
      0 3rem 6rem -2rem #000;
    isolation: isolate;
    transition: box-shadow 1.6s var(--ease-lamp);
  }

  /* Con la cinta corriendo, la pantalla derrama algo de su claridad en la sala */
  .projector[data-state='playing'] .projector__screen {
    box-shadow:
      0 0 0 1px rgb(201 170 108 / 0.3),
      0 0 0 0.55rem #0d0907,
      0 0 0 calc(0.55rem + 1px) rgb(155 125 69 / 0.24),
      0 3rem 6rem -2rem #000,
      0 0 9rem 0.5rem rgb(214 222 230 / 0.1);
  }

  .projector__screen:fullscreen {
    width: 100vw;
    height: 100vh;
    aspect-ratio: auto;
    border-radius: 0;
  }

  .projector__film {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
    cursor: pointer;
  }

  .projector:global(.is-resting) .projector__film {
    cursor: none;
  }

  /* El aviso: sólo sale si falta la bobina o no se puede leer */
  .projector__card {
    position: absolute;
    inset: 0;
    display: grid;
    padding: clamp(0.7rem, 2.6vw, 1.6rem);
    background: radial-gradient(ellipse 90% 80% at 50% 50%, #0d0b09, #030202);
    color: #e9e2d2;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.7s var(--ease-lamp),
      visibility 0.7s;
  }

  .projector:is([data-state='missing'], [data-state='error']) .projector__card {
    opacity: 1;
    visibility: visible;
  }

  .projector__card :global(.plaque) {
    display: grid;
    place-items: center;
    animation: an-weave 1.1s steps(1) infinite;
  }

  .projector__missing,
  .projector__fault {
    max-width: 30ch;
    font-style: italic;
    color: rgb(233 226 210 / 0.7);
  }

  /* Mandos */
  .projector__controls {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    gap: clamp(0.45rem, 1.5vw, 1rem);
    padding: 2.8rem clamp(0.8rem, 2.4vw, 1.5rem) 0.75rem;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.84));
    color: var(--text-bright);
    font-family: var(--font-caps);
    font-size: 0.84rem;
    letter-spacing: 0.08em;
    font-variant-numeric: lining-nums tabular-nums;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s var(--ease-lamp),
      visibility 0.5s;
  }

  .projector[data-state='playing'] .projector__controls,
  .projector[data-state='paused'] .projector__controls {
    opacity: 1;
    visibility: visible;
  }

  /* Sin movimiento en la sala, los mandos se retiran */
  .projector:global(.is-resting) .projector__controls {
    opacity: 0;
    visibility: hidden;
  }

  .projector__controls button {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    transition: color 0.35s;
  }

  .projector__controls button:hover {
    color: var(--candle);
  }

  .projector__controls button[aria-pressed='true'] {
    color: var(--ember-300);
  }

  .projector__controls .projector__speed {
    width: auto;
    min-width: 2.4rem;
  }

  .icon {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon--pause,
  .icon--muted,
  .projector[data-state='playing'] .icon--play,
  [aria-pressed='true'] > .icon--sound {
    display: none;
  }

  .projector[data-state='playing'] .icon--pause,
  [aria-pressed='true'] > .icon--muted {
    display: block;
  }

  /* La barra de avance: un filete fino y un rombo que lo recorre */
  .projector__seek {
    --progress: 0%;
    flex: 1;
    min-width: 2.5rem;
    height: 1.5rem;
    margin: 0;
    background: transparent;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  .projector__seek::-webkit-slider-runnable-track {
    height: 1px;
    background: linear-gradient(90deg, var(--ember-300) var(--progress), rgb(237 223 192 / 0.36) var(--progress));
  }

  .projector__seek::-moz-range-track {
    height: 1px;
    background: linear-gradient(90deg, var(--ember-300) var(--progress), rgb(237 223 192 / 0.36) var(--progress));
  }

  .projector__seek::-webkit-slider-thumb {
    width: 9px;
    height: 9px;
    margin-top: -4px;
    border: 0;
    border-radius: 0;
    background: var(--candle);
    box-shadow: 0 0 0.5rem rgb(236 141 68 / 0.85);
    transform: rotate(45deg);
    -webkit-appearance: none;
    appearance: none;
  }

  .projector__seek::-moz-range-thumb {
    width: 9px;
    height: 9px;
    border: 0;
    border-radius: 0;
    background: var(--candle);
    box-shadow: 0 0 0.5rem rgb(236 141 68 / 0.85);
    transform: rotate(45deg);
  }

  .projector__keys {
    font-family: var(--font-caps);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-align: center;
    color: var(--text-dim);
    opacity: 0.75;
  }

  /* El leve baile de la imagen en la ventanilla del proyector */
  @keyframes an-weave {
    0% { transform: translate(0, 0); opacity: 1; }
    23% { transform: translate(0.4px, -0.3px); opacity: 0.97; }
    41% { transform: translate(-0.3px, 0.4px); opacity: 1; }
    62% { transform: translate(0.2px, 0.3px); opacity: 0.96; }
    84% { transform: translate(-0.4px, -0.2px); opacity: 0.99; }
  }

  @media (hover: none), (max-width: 40rem) {
    .projector__keys {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .projector__card :global(.plaque) {
      animation: none;
    }
  }
</style>
