---
import type { Film } from '@/lib/films';

/**
 * La pantalla de la sesión continua. El esqueleto es común; el orden, el rótulo
 * de cada cinta y la programación los pone src/scripts/continuous.ts al cargar.
 */
interface Props {
  films: Film[];
}
const { films } = Astro.props;

// Sólo lo imprescindible viaja al navegador
const reels = films.map((film) => ({
  slug: film.slug,
  title: film.title,
  year: film.year,
  href: film.href,
  video: film.video!,
  silent: film.silent,
}));
const soleFilm = reels.length === 1;
---

<section class="continuous" data-continuous data-state="loading">
  <script type="application/json" data-reels set:html={JSON.stringify(reels)} />

  <div class="continuous__screen" data-screen>
    <video class="continuous__film" data-film muted autoplay playsinline preload="auto"></video>

    <div class="continuous__loading" aria-hidden="true"><span class="continuous__reel"></span></div>

    <div class="continuous__marquee">
      <p class="continuous__now-label">En pantalla</p>
      <a class="continuous__now" data-nowlink href="#"><span data-now></span></a>
      <p class="continuous__up">
        <span data-nextlabel hidden>A continuación &middot; </span><span data-next></span>
      </p>
    </div>

    <div class="continuous__controls">
      <button type="button" data-action="previous" aria-label="Cinta anterior" title="Cinta anterior">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 5 9 12l8 7zM7 5v14" /></svg>
      </button>
      <button type="button" data-action="toggle" aria-label="Pausar">
        <svg class="icon icon--play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13L18.5 12Z" /></svg>
        <svg class="icon icon--pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12" /></svg>
      </button>
      <button type="button" data-action="next" aria-label="Cinta siguiente" title="Cinta siguiente">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5l8 7-8 7zM17 5v14" /></svg>
      </button>
      <span class="continuous__sep"></span>
      <button type="button" data-action="mute" aria-pressed="true" aria-label="Encender el sonido de la cinta" title="Sonido de la cinta" hidden>
        <svg class="icon icon--sound" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4ZM15.5 9.5a3.5 3.5 0 0 1 0 5M17.8 7a7 7 0 0 1 0 10" /></svg>
        <svg class="icon icon--muted" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4ZM15.5 9.5l5 5M20.5 9.5l-5 5" /></svg>
      </button>
      <button type="button" data-action="fullscreen" aria-label="Pantalla completa" title="Pantalla completa">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" /></svg>
      </button>
    </div>
  </div>

  <div class="continuous__aside">
    <p class="kicker">{soleFilm ? 'En bucle, hasta que llegue más' : 'La sesión de esta noche'}</p>
    <ol class="continuous__list" data-order aria-label="Orden de la sesión"></ol>
    {!soleFilm && <p class="continuous__note">Barajada de nuevo cada vez que entra. Al terminar, vuelve a empezar.</p>}
  </div>
</section>

<style>
  .continuous {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .continuous__screen {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: clamp(0.8rem, 1.6vw, 1.4rem);
    background: #030202;
    box-shadow:
      0 0 0 1px rgb(201 170 108 / 0.3),
      0 0 0 0.5rem #0d0907,
      0 0 0 calc(0.5rem + 1px) rgb(155 125 69 / 0.24),
      0 2.6rem 5rem -2rem #000;
    isolation: isolate;
    transition: box-shadow 1.4s var(--ease-lamp);
  }

  .continuous[data-state='playing'] .continuous__screen {
    box-shadow:
      0 0 0 1px rgb(201 170 108 / 0.3),
      0 0 0 0.5rem #0d0907,
      0 0 0 calc(0.5rem + 1px) rgb(155 125 69 / 0.24),
      0 2.6rem 5rem -2rem #000,
      0 0 8rem 0.5rem rgb(214 222 230 / 0.1);
  }

  .continuous__screen:fullscreen {
    aspect-ratio: auto;
    border-radius: 0;
  }

  .continuous__film {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
    cursor: pointer;
  }

  .continuous.is-resting .continuous__film {
    cursor: none;
  }

  .continuous__loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: #050403;
    opacity: 0;
    transition: opacity 0.5s var(--ease-lamp);
  }

  .continuous[data-state='loading'] .continuous__loading {
    opacity: 1;
  }

  .continuous__reel {
    position: relative;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--brass-500);
    border-radius: 50%;
    animation: an-spin 2.4s linear infinite;
  }

  .continuous__reel::before,
  .continuous__reel::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    border-radius: 50%;
  }

  .continuous__reel::before {
    width: 0.4rem;
    height: 0.4rem;
    background: var(--brass-500);
  }

  .continuous__reel::after {
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid rgb(155 125 69 / 0.4);
  }

  .continuous__marquee {
    position: absolute;
    inset: auto 0 0;
    padding: 3rem clamp(1rem, 3vw, 1.8rem) clamp(1rem, 2.5vw, 1.5rem);
    background: linear-gradient(transparent, rgb(3 2 1 / 0.82));
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 0.7s var(--ease-lamp),
      transform 0.7s var(--ease-lamp);
    pointer-events: none;
  }

  .continuous.is-titled .continuous__marquee {
    opacity: 1;
    transform: none;
  }

  .continuous.is-titled.is-resting .continuous__marquee {
    opacity: 0;
  }

  .continuous__now-label,
  .continuous__up {
    font-family: var(--font-caps);
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    color: var(--brass-300);
  }

  .continuous__now {
    display: inline-block;
    margin: 0.15rem 0 0.35rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.1;
    color: var(--text-bright);
    text-decoration: none;
    pointer-events: auto;
  }

  .continuous__now:hover {
    color: var(--ember-300);
  }

  .continuous__up {
    color: var(--text-dim);
    letter-spacing: 0.1em;
  }

  .continuous__controls {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: clamp(0.4rem, 1.4vw, 0.9rem);
    padding: 2.6rem clamp(0.8rem, 2.4vw, 1.4rem) 0.7rem;
    color: var(--text-bright);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s var(--ease-lamp),
      visibility 0.5s;
  }

  .continuous:is([data-state='playing'], [data-state='paused']):not(.is-resting) .continuous__controls {
    opacity: 1;
    visibility: visible;
  }

  .continuous__controls button {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    transition: color 0.35s;
  }

  .continuous__controls button:hover {
    color: var(--candle);
  }

  .continuous__controls button[aria-pressed='true'] {
    color: var(--ember-300);
  }

  .continuous__sep {
    flex: 1;
  }

  .icon {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon--play path,
  .icon--pause path {
    fill: currentColor;
    stroke: none;
  }

  .icon--pause,
  .icon--muted,
  .continuous[data-state='playing'] .icon--play {
    display: none;
  }

  .continuous[data-state='playing'] .icon--pause,
  [aria-pressed='true'] > .icon--muted {
    display: block;
  }

  [aria-pressed='true'] > .icon--sound {
    display: none;
  }

  .continuous__aside {
    position: sticky;
    top: calc(var(--header-h) + 1rem);
  }

  .continuous__list {
    display: grid;
    gap: 0.1rem;
    margin-top: 1rem;
  }

  /* Las filas las crea el guion al barajar, así que van sin el ámbito del componente */
  .continuous__list :global(.continuous__item button) {
    display: flex;
    align-items: baseline;
    gap: 0.7em;
    width: 100%;
    padding: 0.55rem 0.3rem;
    text-align: left;
    color: var(--text-dim);
    border-bottom: 1px solid var(--rule-faint);
    transition: color 0.4s var(--ease-lamp);
  }

  .continuous__list :global(.continuous__item:last-child button) {
    border-bottom: 0;
  }

  .continuous__list :global(.continuous__item button:hover),
  .continuous__list :global(.continuous__item[aria-current] button) {
    color: var(--text-bright);
  }

  .continuous__list :global(.continuous__dot) {
    flex: none;
    width: 0.4em;
    height: 0.4em;
    margin-top: 0.1em;
    background: var(--soot-500);
    box-shadow: 0 0 0 1px var(--brass-700);
    transform: rotate(45deg);
    transition:
      background 0.5s,
      box-shadow 0.5s;
  }

  .continuous__list :global(.continuous__item[aria-current] .continuous__dot) {
    background: var(--ember-300);
    box-shadow:
      0 0 0 1px var(--ember-700),
      0 0 0.6em 0.1em rgb(236 141 68 / 0.7);
  }

  .continuous__list :global(.continuous__name) {
    flex: 1;
    font-family: var(--font-title);
    font-style: italic;
    font-size: var(--step-0);
    line-height: 1.25;
  }

  .continuous__list :global(.continuous__year) {
    margin-left: 0.6em;
    font-family: var(--font-caps);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    font-variant-numeric: lining-nums;
    color: var(--text-dim);
  }

  .continuous__note {
    margin-top: 1rem;
    font-style: italic;
    font-size: var(--step--1);
    color: var(--text-dim);
  }

  @keyframes an-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 52rem) {
    .continuous {
      grid-template-columns: minmax(0, 1fr);
    }

    .continuous__aside {
      position: static;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .continuous__reel {
      animation: none;
    }
  }
</style>
