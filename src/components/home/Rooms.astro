---
import type { RoomState } from '@/lib/rooms';

/**
 * Las estancias de la casa, como puertas en un pasillo.
 * Las que ya tienen contenido dejan escapar luz por debajo; las demás están a oscuras.
 */
interface Props {
  rooms: RoomState[];
}
const { rooms } = Astro.props;

const stateOf = (room: RoomState) => {
  if (!room.open) return 'Aún a oscuras';
  return room.id === 'films' ? `${room.count} ${room.count === 1 ? 'cinta' : 'cintas'}` : 'Abierta';
};
---

<section class="rooms section" id="estancias">
  <div class="wrap">
    <header class="rooms__head" data-reveal>
      <p class="kicker">La casa</p>
      <h2 class="display">Las estancias</h2>
    </header>

    <ul class="rooms__row">
      {
        rooms.map((room, index) => (
          <li data-reveal style={`--i:${index}`}>
            <a class:list={['door', { 'is-open': room.open }]} href={room.href}>
              <span class="door__light" />
              <span class="door__numeral">{room.numeral}</span>
              <span class="door__name">{room.label}</span>
              <span class="door__blurb">{room.blurb}</span>
              <span class="door__state">
                <span class:list={['lamp', { 'is-on': room.open }]} />
                {stateOf(room)}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .rooms__head {
    display: grid;
    gap: 0.6rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
    text-align: center;
  }

  .rooms__row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2.6vw, 2.2rem);
  }

  .door {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto 1fr auto;
    justify-items: center;
    gap: 0.8rem;
    height: 100%;
    min-height: clamp(21rem, 34vw, 29rem);
    overflow: hidden;
    padding: clamp(3.4rem, 7vw, 5.2rem) clamp(1rem, 2vw, 1.6rem) 1.5rem;
    border: 1px solid var(--rule);
    border-bottom-color: transparent;
    border-radius: 999px 999px 0 0;
    background: linear-gradient(rgb(18 13 10 / 0.9), rgb(11 8 6 / 0.94));
    color: var(--text-dim);
    text-align: center;
    text-decoration: none;
    transition:
      border-color 0.8s var(--ease-lamp),
      color 0.8s var(--ease-lamp);
  }

  /* El segundo filete del marco */
  .door::before {
    content: '';
    position: absolute;
    inset: 5px 5px 0;
    border: 1px solid var(--rule-faint);
    border-bottom: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  /* La rendija de luz bajo la puerta */
  .door::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--soot-500);
    transition:
      background 0.8s var(--ease-lamp),
      box-shadow 0.8s var(--ease-lamp);
  }

  .door__light {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 110% 62% at 50% 104%, rgb(236 141 68 / 0.5), rgb(143 54 19 / 0.16) 55%, transparent 78%);
    opacity: 0;
    transform: translateY(18%);
    transition:
      opacity 1s var(--ease-lamp),
      transform 1.2s var(--ease-lamp);
  }

  .door > :not(.door__light) {
    position: relative;
  }

  .door__numeral {
    font-family: var(--font-caps);
    font-size: var(--step-0);
    letter-spacing: 0.2em;
    color: var(--brass-500);
  }

  .door__name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.05;
    color: var(--text);
    transition: color 0.8s var(--ease-lamp);
  }

  .door__blurb {
    max-width: 22ch;
    font-size: var(--step--1);
    line-height: 1.55;
    font-style: italic;
  }

  .door__state {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    font-family: var(--font-caps);
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    font-variant-numeric: lining-nums;
  }

  .door.is-open {
    color: var(--text);
  }

  .door.is-open .door__name {
    color: var(--text-bright);
  }

  .door.is-open .door__light {
    opacity: 0.55;
  }

  .door.is-open::after {
    background: var(--ember-300);
    box-shadow: 0 0 1.4rem 0.25rem rgb(236 141 68 / 0.55);
  }

  .door:hover,
  .door:focus-visible {
    border-color: rgb(201 170 108 / 0.7);
    border-bottom-color: transparent;
    color: var(--text);
  }

  .door:hover .door__name {
    color: var(--candle);
  }

  .door.is-open:hover .door__light,
  .door.is-open:focus-visible .door__light {
    opacity: 1;
    transform: none;
  }

  /* Una puerta cerrada apenas deja ver un hilo de claridad al acercarse */
  .door:not(.is-open):hover .door__light {
    opacity: 0.16;
  }

  @media (max-width: 62rem) {
    .rooms__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .door {
      min-height: 19rem;
    }
  }

  /* En el móvil caben dos puertas por fila si el rótulo se compone más pequeño */
  @media (max-width: 30rem) {
    .door {
      padding-inline: 0.7rem;
    }

    .door__name {
      font-size: 1.2rem;
    }

    .door__state {
      letter-spacing: 0.1em;
    }
  }
</style>
