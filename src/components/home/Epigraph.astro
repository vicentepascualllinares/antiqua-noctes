---
import SwelledRule from '@/components/ornaments/SwelledRule.astro';
---

<section class="epigraph section">
  <blockquote class="wrap wrap--narrow" data-reveal>
    <p>«Todo lo que vemos o parecemos no es más que un sueño dentro de un sueño.»</p>
    <SwelledRule width="7rem" />
    <footer>Edgar Allan Poe</footer>
  </blockquote>
</section>

<style>
  .epigraph blockquote {
    display: grid;
    justify-items: center;
    gap: 1.6rem;
    margin-block: 0;
    text-align: center;
  }

  .epigraph p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1.3;
    color: var(--text-bright);
    text-wrap: balance;
  }

  .epigraph footer {
    font-family: var(--font-caps);
    font-size: var(--step--1);
    letter-spacing: 0.24em;
    color: var(--brass-300);
  }
</style>
